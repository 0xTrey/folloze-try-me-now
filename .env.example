# Public origin used when minting temporary and claimed experience URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Explicit modes prevent ambient machine credentials from activating integrations.
GENERATION_MODE=fixture
BRAND_MODE=fast
FOLLOZE_MODE=disabled
EMAIL_MODE=console

# OpenAI. Set GENERATION_MODE=openai only with this project's fresh key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Default 52s; the server clamps overrides between 10s and 58s so generation
# remains inside the public 30–60 second quality window.
TRY_ME_GENERATION_TIMEOUT_MS=52000

# Durable session state. Blob is preferred for its ETag compare-and-set updates.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# Durable lead ledger. Use the pooled Neon connection string at runtime.
DATABASE_URL=

# Redis supplies distributed limits. Redis-only session compatibility is not
# production-safe until its writes enforce an atomic revision/CAS contract.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional remote Brand Harvester service. Set BRAND_MODE=remote to enable it.
BRAND_HARVESTER_URL=
BRAND_HARVESTER_TOKEN=
# Optional server-only final logo fallback. Never expose this as NEXT_PUBLIC_*.
BRANDFETCH_API_KEY=

# Remote Folloze MCP gateway. Only FOLLOZE_MODE=publish plus URL and auth may publish.
FOLLOZE_MCP_SERVER_URL=
FOLLOZE_MCP_AUTH_TOKEN=
FOLLOZE_MCP_TOOL_NAME=create_try_me_experience
FOLLOZE_ALLOWED_PUBLIC_HOSTS=engage.folloze.com,experience.folloze.com
FOLLOZE_THEME_ID=
FOLLOZE_THEME_URL=

# Transactional claim email. Set EMAIL_MODE=resend to enable it.
RESEND_API_KEY=
EMAIL_FROM=Folloze <try@updates.folloze.com>
EMAIL_REPLY_TO=

# Server-only QA exception list. Accepts exact emails or domains; leave empty in production.
TRY_ME_BUSINESS_EMAIL_ALLOWLIST=

# Product configuration.
TRY_ME_SESSION_TTL_SECONDS=1800
TRY_ME_MAX_PDF_BYTES=10485760
TRY_ME_DEMO_MODE=true
NEXT_PUBLIC_DEMO_CTA_URL=https://www.folloze.com/book-a-meeting
