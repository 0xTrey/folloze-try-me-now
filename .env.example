# Public origin used when minting temporary and claimed experience URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Explicit modes prevent ambient machine credentials from activating integrations.
GENERATION_MODE=fixture
BRAND_MODE=fast
FOLLOZE_MODE=disabled
EMAIL_MODE=console

# OpenAI. Set GENERATION_MODE=openai only with this project's fresh key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# The refinement pass gets 30s. The provisional preview never waits for it,
# and the shared deadline still reserves T+55 through T+60 for finalization.
# remaining budget belongs to verified enrichment, rendering, and delivery.
TRY_ME_GENERATION_TIMEOUT_MS=30000

# Durable session state. Blob is preferred for its ETag compare-and-set updates.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# Durable lead ledger. Use the pooled Neon connection string at runtime.
DATABASE_URL=

# Redis supplies distributed limits. Redis-only session compatibility is not
# production-safe until its writes enforce an atomic revision/CAS contract.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional remote Brand Harvester service. Set BRAND_MODE=remote to enable it.
BRAND_HARVESTER_URL=
BRAND_HARVESTER_TOKEN=
# Browser evidence is enrichment inside the 60s customer promise, not a
# separate minute-long prerequisite. Public HTML/CSS and Brandfetch run beside it.
TRY_ME_BRAND_HARVESTER_TIMEOUT_MS=12000
# Brandfetch starts immediately and runs alongside the public-site harvester.
# The client ID is intentionally used only in browser Logo/Search API URLs; the
# Brand API key is server-only and must never be exposed as NEXT_PUBLIC_*.
# If Brandfetch and first-party CSS cannot verify a palette, generation stops
# with an explicit error instead of applying generic colors.
BRANDFETCH_MODE=enrich
BRANDFETCH_CLIENT_ID=
BRANDFETCH_API_KEY=

# Remote Folloze MCP gateway. Only FOLLOZE_MODE=publish plus URL and auth may publish.
FOLLOZE_MCP_SERVER_URL=
FOLLOZE_MCP_AUTH_TOKEN=
FOLLOZE_MCP_TOOL_NAME=create_try_me_experience
FOLLOZE_ALLOWED_PUBLIC_HOSTS=engage.folloze.com,experience.folloze.com
FOLLOZE_THEME_ID=
FOLLOZE_THEME_URL=

# Transactional email. Use agentmail for personalization delivery or resend
# for the legacy claim receipt. Provider credentials stay server-only.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
RESEND_API_KEY=
EMAIL_FROM=Folloze <try@updates.folloze.com>
EMAIL_REPLY_TO=

# Optional Marketo REST lead sync. Disabled unless all server-only credentials are set.
# The Munchkin ID is public tracking configuration only; it does not enable REST sync.
MARKETO_MODE=disabled
MARKETO_REST_ENDPOINT=
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=
MARKETO_CUSTOM_ACTIVITY_TYPE_ID=
NEXT_PUBLIC_MARKETO_MUNCHKIN_ID=

# Server-only QA exception list. Accepts exact emails or domains; leave empty in production.
TRY_ME_BUSINESS_EMAIL_ALLOWLIST=

# Product configuration.
TRY_ME_SESSION_TTL_SECONDS=1800
TRY_ME_MAX_PDF_BYTES=10485760
TRY_ME_DEMO_MODE=true
NEXT_PUBLIC_DEMO_CTA_URL=https://www.folloze.com/book-a-meeting

# Optional PostHog analysis UI. The project token (phc_) is intended for browser use;
# never place a personal API key (phx_) in a NEXT_PUBLIC variable. The first-party
# database remains authoritative when PostHog is unavailable.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=/signal-dock
# Keep replay off until privacy approval. When enabled, all form inputs stay masked.
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false
