{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/sessions/**": {
      "maxDuration": 300
    },
    "src/app/api/maintenance/**": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/maintenance/upload-cleanup",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/maintenance/lead-reconciliation",
      "schedule": "*/5 * * * *"
    }
  ]
}
